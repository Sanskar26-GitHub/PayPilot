# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Supabase or PostgreSQL).
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# PAYPAL_CLIENT_ID: PayPal Developer Sandbox App Client ID.
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="MY_PAYPAL_SANDBOX_CLIENT_ID"

# PAYPAL_CLIENT_SECRET: PayPal Developer Sandbox App Secret.
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_SECRET="MY_PAYPAL_SANDBOX_CLIENT_SECRET"

# PAYPAL_BASE_URL: PayPal API endpoint (defaults to Sandbox).
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
